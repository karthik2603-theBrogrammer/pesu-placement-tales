# Neon Postgres connection string (https://neon.tech)
DATABASE_URL=

# Optional: target DB for scripts/migrate-database.mjs (source → new)
DATABASE_URL_NEW=

# Secret token that guards the admin stats console (/7a1f9c4e2b6d80a3)
# Use a long random string. Requests must send it as the x-admin-token header.
ADMIN_TOKEN=

# PostHog analytics (https://posthog.com)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Server-only PostHog query access (never expose to the client)
# Create at PostHog → Settings → Personal API keys (Query read permission)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com
