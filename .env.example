# Neon Postgres connection string (https://neon.tech) — use your own development database
DATABASE_URL=

# Optional: PostHog analytics (https://posthog.com). Leave empty to disable.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: server-only PostHog query access, used to rank trending stories (never expose to the client)
# Create at PostHog → Settings → Personal API keys (Query read permission)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com